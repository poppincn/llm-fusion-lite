# LLM Fusion Lite — provider credentials & settings.
#
# Copy this to ONE of:
#   • ./.env                      (repo-local, git-ignored)
#   • ~/.llm-fusion-lite/.env     (machine-wide, used by `fusion-lite` from any directory)
# …or just `export` these in your shell profile. Real environment variables
# always win over .env files; .env never overrides an already-set variable.
#
# Configure at least one provider below, a subscription CLI, or a custom
# OpenAI-compatible provider in the dashboard. More providers improve diversity.

ANTHROPIC_API_KEY=        # https://console.anthropic.com/  → API Keys
OPENAI_API_KEY=          # https://platform.openai.com/api-keys
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey   (GEMINI_API_KEY also accepted)

# Optional overrides
# LLM_FUSION_LITE_HOME=~/.llm-fusion-lite   # where config.json, fusion.db, and .env live
# LLM_FUSION_LITE_PORT=8787                 # server port
# The external /v1 gateway API key is configured under Web UI → Connect.
# Leave it empty there to keep the gateway unauthenticated (the default).
